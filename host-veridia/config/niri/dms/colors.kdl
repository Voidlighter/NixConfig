layout {
    background-color "transparent"

    focus-ring {
        active-color   "#56dbc5"
        inactive-color "#7f94a0"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#56dbc5"
        inactive-color "#7f94a0"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#56dbc5"
        inactive-color "#7f94a0"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#56dbc580"
    }
}

recent-windows {
    highlight {
        active-color   "#005046"
        urgent-color   "#ffb4ab"
    }
}
